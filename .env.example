# Public site URL (used for SEO metadata, canonical URLs, and sitemap)
NEXT_PUBLIC_SITE_URL=https://kalkanpartner.de

# Admin Panel Authentication (/admin)
# IMPORTANT: Set these in Vercel -> Settings -> Environment Variables. Never commit real secrets to Git.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# GitHub CMS Persistence (Allows /admin to save changes directly to your private GitHub repository on Vercel)
GITHUB_CMS_TOKEN=
GITHUB_CMS_REPO=1likte/kalkanpartner
GITHUB_CMS_BRANCH=main

# Email Delivery (/api/contact) - Configure EITHER Standard SMTP (Option A) OR Resend API (Option B)
# Option A: Standard Mailbox SMTP (IONOS, Strato, Hostinger, Zoho, Gmail App Password, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=kontakt@kalkanpartner.de
SMTP_PASS=

# Option B: Resend API
RESEND_API_KEY=

CONTACT_FROM_EMAIL=kontakt@kalkanpartner.de
CONTACT_TO_EMAIL=kontakt@kalkanpartner.de

# Optional Messenger & Scalability Hooks
NEXT_PUBLIC_TELEGRAM_URL=
CRM_WEBHOOK_URL=
NEXT_PUBLIC_BOOKING_URL=
