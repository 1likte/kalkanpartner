# Public site URL (used for SEO metadata, canonical URLs, and sitemap)
NEXT_PUBLIC_SITE_URL=https://example.com

# Future Email Delivery (Milestone 3 - Contact System)
# Configure either Resend or SMTP when ready. Never commit .env.local to Git.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Future Scalability Hooks (Optional)
CRM_WEBHOOK_URL=
NEXT_PUBLIC_BOOKING_URL=
